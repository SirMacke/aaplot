{
  "name": "aaplot",
  "version": "0.0.1",
  "description": "Terminal dashboard for Artificial Analysis model data — charts, rankings, comparisons. Unofficial.",
  "type": "module",
  "bin": {
    "aaplot": "./dist/bin/aaplot.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset"
  },
  "dependencies": {
    "env-paths": "^4.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "eslint": "^10.8.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "tui",
    "artificial-analysis",
    "llm",
    "benchmarks",
    "terminal",
    "charts"
  ]
}
